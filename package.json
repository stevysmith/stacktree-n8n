{
  "name": "n8n-nodes-stacktree",
  "version": "0.1.0",
  "description": "Publish agent-made HTML to a private, unguessable URL. Gate it with a password or email domain, expire or burn it, and read the feedback viewers leave.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "stacktree",
    "publish",
    "html",
    "hosting",
    "private-hosting",
    "static-site",
    "claude",
    "mcp",
    "agent",
    "ai"
  ],
  "license": "MIT",
  "author": {
    "name": "Stacktree",
    "email": "hello@stacktr.ee"
  },
  "homepage": "https://stacktr.ee",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevysmith/stacktree-n8n.git"
  },
  "main": "dist/nodes/Stacktree/Stacktree.node.js",
  "scripts": {
    "dev": "n8n-node dev",
    "build": "n8n-node build",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "prepublishOnly": "n8n-node build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/StacktreeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Stacktree/Stacktree.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "latest",
    "n8n-workflow": "*",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  }
}
